{
  "name": "code-atlas",
  "version": "0.1.0",
  "description": "Find duplicates, unused code, hotspots and security hints in TypeScript repos. JSON output for coding agents, runs locally on top of a GitNexus index.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domci/code-atlas.git"
  },
  "keywords": [
    "typescript",
    "duplicate-code",
    "dead-code",
    "code-analysis",
    "technical-debt",
    "ai-agents",
    "embeddings",
    "gitnexus"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "type": "module",
  "bin": {
    "atlas": "src/cli.ts"
  },
  "scripts": {
    "atlas": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@ladybugdb/core": "0.18.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "@ladybugdb/core",
    "onnxruntime-node"
  ]
}
